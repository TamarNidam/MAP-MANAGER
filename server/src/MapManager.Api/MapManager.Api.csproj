<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML comments feed Swagger. Self-explanatory members are left without one, so CS1591 is not reported. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- MongoDB.Driver: database access and GeoJSON types. Swashbuckle.AspNetCore: Swagger UI and OpenAPI document. -->
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
