{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(node --version)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ]
  }
}